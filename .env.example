# Required: create a bot with @BotFather and paste its token here
BOT_TOKEN=123456:replace_me

# Leave default for official Telegram Bot API.
# For large files, point this to your separately hosted Local Bot API Server, e.g. http://127.0.0.1:8081
BOT_API_BASE=https://api.telegram.org

# Optional comma-separated Telegram user IDs. Empty means anyone can use the bot.
ALLOWED_USER_IDS=

WORK_DIR=./data
CONVERSION_TIMEOUT_SECONDS=7200
MIN_FREE_DISK_MB=512
# Official Bot API has a much lower upload cap; Local Bot API Server supports larger files.
MAX_UPLOAD_MB=45
RUST_LOG=info
